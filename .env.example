BOT_TOKEN=PASTE_BOT_TOKEN_HERE
ADMIN_IDS=2097006037
BOT_DATA_DIR=/app/data
DB_PATH=boostora.db
BRAND_NAME=Boostora
SUPPORT_USERNAME=@BoostoraBot
DEFAULT_HOLD_HOURS=24
DEMO_HOLD_MINUTES=3
# Устаревший демо-топап отключён: новые пользователи получают только штатный стартовый бонус.
ENABLE_DEMO_TOPUP=0
ENABLE_XTR_PAYMENTS=1
REQUIRED_CHAT_ID=@Boostorachat
REQUIRED_CHAT_INVITE_LINK=https://t.me/Boostorachat

# Глобальная защита групп: до личного /start сообщения пользователя удаляются во всех группах с Boostora.
CHAT_START_GATE_ENABLED=1
CHAT_START_GATE_CHAT_REF=@Boostorachat
CHAT_START_GATE_CHAT_LINK=https://t.me/Boostorachat
CHAT_START_GATE_START_PARAMETER=chat_access
CHAT_START_GATE_NOTICE_COOLDOWN_SECONDS=15
PROMO_INTERVAL_HOURS=18
RUN_COMMAND=python3 main.py

# Smart UI / Mini App — работает в том же проекте и на том же домене Bothost.
SMART_BOTTOM_MENU=compact
WEBAPP_ENABLED=1
WEBAPP_REQUIRED=1
WEBAPP_HOST=0.0.0.0
PORT=3000
# Оставь пустым, чтобы встроенный сервер использовал PORT.
WEBAPP_PORT=
WEBAPP_URL=https://boostorabot.bothost.tech
# Резервные алиасы публичного адреса.
PUBLIC_BASE_URL=https://boostorabot.bothost.tech
DOMAIN=boostorabot.bothost.tech
# Необязательный старый алиас. Если заполнены обе переменные, MINI_APP_URL имеет приоритет.
MINI_APP_URL=
# Максимальный возраст подписанной Telegram-сессии Mini App.
WEBAPP_AUTH_MAX_AGE_SECONDS=86400

# Boostora v4.0.0 — защита Mini App API.
# Лимиты применяются отдельно для каждого подтверждённого Telegram user id.
BOOSTORA_API_READS_PER_MINUTE=180
BOOSTORA_API_MUTATIONS_PER_MINUTE=45
BOOSTORA_API_RATE_WINDOW_SECONDS=60
# После сетевого обрыва клиент повторяет финансовую/рабочую mutation с тем же ключом.
BOOSTORA_IDEMPOTENCY_TTL_SECONDS=180
BOOSTORA_IDEMPOTENCY_CACHE_MAX=4096
# Верхняя граница памяти для rate buckets; значения автоматически очищаются.
BOOSTORA_RATE_BUCKETS_MAX=20000

# External provider: Boostore.ru API
BOOSTORE_ENABLED=0
BOOSTORE_API_URL=https://boostore.ru/api/v2
BOOSTORE_API_KEY=
# Не вшивай ключ в код и не публикуй его в GitHub. Вставь настоящий ключ только в Bothost/.env.
BOOSTORE_DEFAULT_MARKUP_PERCENT=35
BOOSTORE_REQUEST_TIMEOUT_SECONDS=20
BOOSTORE_AUTO_SYNC=0
# Реальное создание заказа после списания кредитов. Оставь 0 до живой проверки API.
BOOSTORE_AUTO_ORDER_ENABLED=0
# Старые неоплаченные заказы закрываются автоматически через указанное время.
PROVIDER_ORDER_TIMEOUT_MINUTES=20

# Единая экономика Boostora
# Stars используются только для покупки кредитов/Искр.
CREDITS_PER_STAR=10
# Сколько кредитов соответствует одной единице цены поставщика до наценки.
PROVIDER_CREDITS_PER_PRICE_UNIT=10
# Бонусами нельзя покрыть больше этого процента разрешённого заказа.
MAX_BONUS_PAYMENT_PERCENT=50
# Комиссия пользовательских заданий по умолчанию 20%; меняется владельцем в Mini App.

# Сеть рекламных размещений
NETWORK_MIN_MEMBERS=100
NETWORK_MAX_PLATFORMS_PER_USER=10
NETWORK_BASE_PLACEMENT_CREDITS=60

# Правила сообщества: перед заданиями/продвижением пользователь должен согласиться.
COMMUNITY_RULES_REQUIRED=1
COMMUNITY_RULES_VERSION=2026-07-28-v2

# Режимы продвижения
ENGAGEMENT_STANDARD_REQUIRED_ACTIONS=10
# Используется только как резерв для стартовой цены PRO в кредитах: 199 × CREDITS_PER_STAR.
# Новые покупки PRO происходят за кредиты, а не напрямую за Stars.
ENGAGEMENT_PRO_MONTHLY_STARS=199

# Мягкие ограничения Standard и напоминания 0/10
# Сколько часов даётся Standard-пользователю на выполнение 10 ответных действий.
ENGAGEMENT_OBLIGATION_DUE_HOURS=24
# Включить авто-напоминания пользователю по обязательствам 0/10.
ENGAGEMENT_REMINDERS_ENABLED=1
# За сколько часов до срока отправлять мягкое напоминание.
ENGAGEMENT_REMINDER_BEFORE_HOURS=6
# Если есть просрочка Standard — не давать запускать новые лайки/комментарии/реакции, пока долг не закрыт.
ENGAGEMENT_OVERDUE_BLOCKS_STANDARD=1
# Отправлять владельцу/админам одно предупреждение по просроченному обязательству.
ENGAGEMENT_ADMIN_WARNINGS_ENABLED=1

# Юридические документы и единое соглашение
LEGAL_DOCS_REQUIRED=1
LEGAL_DOCS_VERSION=2026-07-28-v2

# Безопасный перезапуск
# 0 = сохранить ожидающие Telegram-обновления после перезапуска (рекомендуется).
# 1 = намеренно пропускать накопившиеся обновления при каждом старте.
DROP_PENDING_UPDATES=0

# Безопасное восстановление и снимки SQLite
# 1 = при пустой основной БД один раз искать старую рабочую БД в legacy-папках.
LEGACY_DB_RESTORE_ENABLED=1
# 0 = не создавать дополнительные legacy-копии после каждой записи (рекомендуется).
# Включай временно только при контролируемом переносе со старого размещения.
LEGACY_DB_MIRROR_ENABLED=0
# Минимальный интервал между legacy-снимками, если зеркало включено.
LEGACY_MIRROR_INTERVAL_SECONDS=300

# Изоляция фоновых задач и регулярные безопасные копии БД.
BACKGROUND_WORKER_INTERVAL_SECONDS=300
DB_BACKUP_INTERVAL_HOURS=12
DB_BACKUP_MAX_FILES=10
